# YouTube Data API v3 Key
# Get yours at: https://console.cloud.google.com/
# 1. Create a project
# 2. Enable "YouTube Data API v3"
# 3. Create credentials -> API key
YOUTUBE_API_KEY=your_api_key_here

# OpenRouteService API Key (optional - enables auto-routing from waypoints)
# Get yours at: https://openrouteservice.org/dev/#/signup
# 1. Create a free account
# 2. Request a token from your dashboard
# Free tier: 2,000 directions/day, 40/minute
OPENROUTESERVICE_API_KEY=your_api_key_here

# CARTO Basemaps API Key (required for the styled light/dark map - without it tiles show an "API KEY REQUIRED" watermark)
# Get yours at: https://carto.com/basemaps/apikey
# Free tier: 5,000,000 tile requests/month, non-commercial use
# NEXT_PUBLIC_ prefix is required: the key is used by the browser when loading map tiles
NEXT_PUBLIC_CARTO_API_KEY=your_api_key_here
